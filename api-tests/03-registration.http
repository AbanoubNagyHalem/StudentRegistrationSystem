### ========================================
### 0. Login as Ahmed (Active student)
### ========================================
# @name loginAhmed
POST http://localhost:5039/api/auth/login
Content-Type: application/json

{
    "registrationNumber": "20240001",
    "pin": "1234"
}


### ========================================
### 1. Check Eligibility
### ========================================
GET http://localhost:5039/api/registration/eligibility
Authorization: Bearer {{loginAhmed.response.body.$.token}}


### ========================================
### 2. Get Available Courses
### ========================================
GET http://localhost:5039/api/registration/available-courses
Authorization: Bearer {{loginAhmed.response.body.$.token}}


### ========================================
### 3. Get Sections for CS202 (Database Systems)
### ========================================
GET http://localhost:5039/api/registration/sections?courseId=4
Authorization: Bearer {{loginAhmed.response.body.$.token}}


### ========================================
### 4. Validate - CS202 (Sec 1) — PASS
### ========================================
POST http://localhost:5039/api/registration/validate
Authorization: Bearer {{loginAhmed.response.body.$.token}}
Content-Type: application/json

{
    "sectionIds": [7]
}


### ========================================
### 5. Validate - Full Section — FAIL
### ========================================
POST http://localhost:5039/api/registration/validate
Authorization: Bearer {{loginAhmed.response.body.$.token}}
Content-Type: application/json

{
    "sectionIds": [4]
}


### ========================================
### 6. Validate - CONFLICT (CS102 + CS201)
### ========================================
POST http://localhost:5039/api/registration/validate
Authorization: Bearer {{loginAhmed.response.body.$.token}}
Content-Type: application/json

{
    "sectionIds": [3, 6]
}


### ========================================
### 7. Confirm Registration - CS202 + MATH102
### ========================================
POST http://localhost:5039/api/registration/confirm
Authorization: Bearer {{loginAhmed.response.body.$.token}}
Content-Type: application/json

{
    "sectionIds": [7, 9]
}


### ========================================
### 8. Get Current Schedule
### ========================================
GET http://localhost:5039/api/schedule/current
Authorization: Bearer {{loginAhmed.response.body.$.token}}


