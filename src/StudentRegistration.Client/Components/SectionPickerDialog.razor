@using StudentRegistration.Client.Models

<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">
      Select Section — @CourseCode
    </MudText>
    <MudText Typo="Typo.caption" Color="Color.Secondary">
      @CourseName · @CourseCreditHours credit hours
    </MudText>
  </TitleContent>

  <DialogContent>
    @if (Sections.Count == 0)
    {
      <MudAlert Severity="Severity.Warning">
        No sections available for this course in the current semester.
      </MudAlert>
    }
    else
    {
      <div class="d-flex flex-column gap-2">
        @foreach (var s in Sections)
        {
          <MudPaper Elevation="@GetElevation(s)" Class="@GetCardClass(s)" Style="@GetCardStyle(s)"
                    @onclick="@(() => Select(s))">
            <div class="d-flex align-center">
              <MudText Typo="Typo.subtitle1" Style="font-weight:600;">
                Section @s.SectionNumber
              </MudText>
              <MudSpacer />
              <MudChip T="string" Size="Size.Small"
                       Color="@(s.IsFull ? Color.Error : (s.Capacity - s.EnrolledCount <= 5 ? Color.Warning : Color.Success))"
                       Variant="Variant.Filled">
                @s.EnrolledCount / @s.Capacity seats
              </MudChip>
            </div>

            <MudDivider Class="my-2" />

            <div class="d-flex align-center gap-4 flex-wrap">
              <div>
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                <span class="ml-1">@s.InstructorName</span>
              </div>
              @if (!string.IsNullOrEmpty(s.TeachingAssistantName))
              {
                <div>
                  <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Small" />
                  <span class="ml-1">@s.TeachingAssistantName</span>
                </div>
              }
            </div>

            <div class="mt-2">
              @foreach (var sch in s.Schedules)
              {
                <div class="d-flex align-center gap-2" style="font-size:13px;">
                  <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Primary" />
                  <span><strong>@sch.DayOfWeek</strong> @sch.StartTime – @sch.EndTime</span>
                  @if (!string.IsNullOrEmpty(sch.Room))
                  {
                    <span style="color:#888;">(@sch.Room)</span>
                  }
                </div>
              }
            </div>

            @if (s.IsFull)
            {
              <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                Section is FULL
              </MudAlert>
            }
          </MudPaper>
        }
      </div>
    }
  </DialogContent>

  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_selectedId is null)" OnClick="Confirm">
      Add Course
    </MudButton>
  </DialogActions>
</MudDialog>

<style>
  .section-card {
    transition: all 0.15s;
    border: 2px solid transparent;
  }

  .section-card:hover:not(.full) {
    border-color: #594AE2;
    transform: translateY(-1px);
  }

  .section-card.selected {
    border-color: #594AE2;
    background: #f0eeff;
  }

  .section-card.full {
    opacity: 0.6;
  }
</style>

@code {
  [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

  [Parameter] public string CourseCode { get; set; } = string.Empty;
  [Parameter] public string CourseName { get; set; } = string.Empty;
  [Parameter] public int CourseCreditHours { get; set; }
  [Parameter] public List<CourseSectionDto> Sections { get; set; } = new();

  private int? _selectedId;

  private int GetElevation(CourseSectionDto s) => _selectedId == s.Id ? 4 : 1;

  private string GetCardClass(CourseSectionDto s)
  {
    var cls = "pa-3 section-card";
    if (_selectedId == s.Id) cls += " selected";
    if (s.IsFull) cls += " full";
    return cls;
  }

  private string GetCardStyle(CourseSectionDto s)
  {
    var cursor = s.IsFull ? "not-allowed" : "pointer";
    return $"border-radius:10px;cursor:{cursor};";
  }

  private void Select(CourseSectionDto s)
  {
    if (s.IsFull) return;
    _selectedId = s.Id;
  }

  private void Cancel() => MudDialog.Cancel();

  private void Confirm()
  {
    if (_selectedId is null) return;
    MudDialog.Close(DialogResult.Ok(_selectedId.Value));
  }
}