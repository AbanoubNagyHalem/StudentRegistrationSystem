@using StudentRegistration.Client.Models

<MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius:12px;">
  <MudGrid Spacing="2">
    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">Registration No.</MudText>
      <MudText Typo="Typo.body1" Style="font-weight:600;">@Profile.RegistrationNumber</MudText>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">Full Name</MudText>
      <MudText Typo="Typo.body1" Style="font-weight:600;">@Profile.FullName</MudText>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">Level</MudText>
      <MudChip T="string" Size="Size.Small" Color="@LevelColor" Variant="Variant.Filled">
        @Profile.Level
      </MudChip>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">College</MudText>
      <MudText Typo="Typo.body1">@Profile.CollegeName</MudText>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">Department</MudText>
      <MudText Typo="Typo.body1">@Profile.DepartmentName</MudText>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">Study Plan</MudText>
      <MudText Typo="Typo.body1">@(Profile.StudyPlanName ?? "—")</MudText>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
      <MudChip T="string" Size="Size.Small" Color="@StatusColor" Variant="Variant.Filled">
        @Profile.Status
      </MudChip>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">GPA</MudText>
      <MudText Typo="Typo.body1" Style="font-weight:600;">
        @(Profile.GPA?.ToString("0.00") ?? "—")
      </MudText>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
      <MudText Typo="Typo.caption" Color="Color.Secondary">Sponsor</MudText>
      <MudText Typo="Typo.body1">@(Profile.Sponsor ?? "—")</MudText>
    </MudItem>
  </MudGrid>
</MudPaper>

@code {
  [Parameter, EditorRequired] public StudentProfileDto Profile { get; set; } = null!;

  private Color StatusColor => Profile.Status switch
  {
    "Active" => Color.Success,
    "Graduated" => Color.Info,
    "Suspended" => Color.Warning,
    "Dismissed" => Color.Error,
    _ => Color.Default
  };

  private Color LevelColor => Profile.Level switch
  {
    "Master" => Color.Primary,
    "Bachelor" => Color.Secondary,
    _ => Color.Default
  };
}